

# Leave DATABASE_URL blank to use the clearly labeled in-memory demo.
DATABASE_URL=
PORT=4000
NODE_ENV=development
PG_POOL_MAX=10

# For RDS, use TLS and provide the AWS RDS CA bundle path. Verification remains enabled.
PG_SSL=false
PG_CA_CERT_PATH=

# Required in addition to the explicit API confirmation before contract drops the legacy column.
LEGACY_CLIENTS_RETIRED=false

# Optional CloudWatch metrics integration. No credentials belong in frontend variables.
AWS_REGION=
CLOUDWATCH_NAMESPACE=CloudShift/Migrations
